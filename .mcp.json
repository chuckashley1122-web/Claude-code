{
  "mcpServers": {
    "elevenlabs": {
      "type": "stdio",
      "command": "uvx",
      "args": ["elevenlabs-mcp"],
      "env": {
        "ELEVENLABS_API_KEY": "${ELEVENLABS_API_KEY}"
      }
    },
    "ghl-mcp": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--directory", "${GHL_MCP_DIR}", "python", "-m", "src.main"]
    }
  }
}
