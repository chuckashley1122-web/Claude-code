# Copy to config/location.env — which is gitignored, and must stay that way.
# Secret VALUES never live here. This file names which location a build targets
# and which environment variables hold the credentials.

# The sub-account every write goes to. The builder refuses to touch any other.
# Start with a sandbox sub-account, not production.
GHL_LOCATION=

# Name of the env var holding the Private Integration Token. The token itself
# stays in your shell profile or keychain — see docs/ghl-mcp-setup.md.
GHL_PIT_TOKEN_VAR=GHL_PIT_TOKEN

# Asset name prefix. Anything without this prefix was not created by the
# builder, and the builder will not modify or delete it.
GHL_ASSET_PREFIX=CAJ
