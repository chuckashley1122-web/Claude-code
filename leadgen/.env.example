# ---- LLM (for scrapegraph-ai enrichment). Pick ONE. ----
OPENAI_API_KEY=
# or run local models instead and set LEADGEN_LLM_MODEL=ollama/llama3.2
LEADGEN_LLM_MODEL=openai/gpt-4o-mini

# ---- Lead data providers (LinkedIn firmographic data, compliantly licensed) ----
# Apollo.io  -> https://developer.apollo.io  (People/Org Search + Enrich)
APOLLO_API_KEY=
# Bright Data -> LinkedIn public-profile dataset API
BRIGHTDATA_API_KEY=
BRIGHTDATA_LINKEDIN_DATASET_ID=

# ---- Optional: outbound proxy for browser fetchers (leave blank on your machine) ----
LEADGEN_PROXY=
# Optional: pin a Playwright/Chromium binary (leave blank to use the bundled one)
LEADGEN_CHROMIUM_PATH=
