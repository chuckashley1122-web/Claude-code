# Secrets — never commit. Keys live in environment variables or your keychain.
.env
.env.*
*.local
.claude/settings.local.json
.mcp.local.json
*.pem
*.key

# Local Claude Code state
.claude/todos/
.claude/shell-snapshots/

# OS / editor noise
.DS_Store

# Odysseus approved knowledge sources — real business documents, never committed.
# The README in each directory is the exception, so the convention stays visible.
odysseus/workspaces/*/approved/*
!odysseus/workspaces/*/approved/README.md
