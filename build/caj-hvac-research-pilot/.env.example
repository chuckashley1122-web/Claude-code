# Names only. Never put a real value in a committed file. .env is gitignored.
# Default true. false refuses to run unless a human also sets ALLOW_LIVE=1.
DRY_RUN=
# Human-only gate. Not a substitute for approval.
ALLOW_LIVE=
# Default false. Human-only. Enabling it does not make retrieval possible: LiveRetriever raises LiveCallBlocked.
ALLOW_NETWORK_RETRIEVAL=
# Overrides the pinned PROJECT_ROOT. Human decision.
CAJ_RESEARCH_PROJECT_ROOT=
# Default 3. Values above 3 are refused: raising it is a scope change, not a config tweak.
CAJ_RESEARCH_MAX_COMPANIES=
# Default 3 (homepage + at most two same-domain pages). Values above 3 are refused.
CAJ_RESEARCH_MAX_PAGES_PER_COMPANY=
# Default 1. Values above 1 are refused.
CAJ_RESEARCH_MAX_RETRIES=
# Default ../../ui-work-orders (repo root).
CAJ_RESEARCH_UI_WORK_ORDER_DIR=
# Default tests/fixtures. Tests only.
CAJ_RESEARCH_FIXTURE_DIR=
