# GoHighLevel API v2 credentials
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Private Integration Token from GHL: Settings -> Private Integrations -> Create
# Required scopes for full demo: contacts.readonly, contacts.write,
# opportunities.readonly, opportunities.write, conversations.readonly,
# conversations.write, conversations/message.write, locations.readonly
GHL_API_KEY=

# Sub-account (location) ID this PIT was issued for.
# Find it in GHL: Settings -> Business Profile -> Location Id
GHL_LOCATION_ID=

# Optional override; defaults to the public LeadConnector base URL.
# GHL_BASE_URL=https://services.leadconnectorhq.com

# Optional API version header; defaults to 2021-07-28.
# GHL_API_VERSION=2021-07-28
