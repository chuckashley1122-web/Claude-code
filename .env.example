# Template only — copy, fill in, and never commit the real values.
# See docs/jarvis-setup.md and docs/ghl-mcp-setup.md.

# ElevenLabs MCP (Jarvis). Export in your shell profile or keychain.
ELEVENLABS_API_KEY=sk_...

# GoHighLevel MCP — path to your local clone of
# https://github.com/basicmachines-co/open-ghl-mcp
GHL_MCP_DIR=/path/to/open-ghl-mcp

# The two below belong in open-ghl-mcp/.env, NOT in this repo.
# From your GoHighLevel Marketplace app (marketplace.gohighlevel.com).
# GHL_CLIENT_ID=your_client_id
# GHL_CLIENT_SECRET=your_client_secret
